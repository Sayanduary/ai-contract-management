# Backend Environment Variables

# PostgreSQL Connection String (Supabase)
# Format: postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Direct Connection URL (used by Prisma migrations - Supabase session mode)
# Use port 5432 for direct connections, port 6543 for pooled (transaction mode)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# JWT Secret Key — use a long random string (min 32 chars)
JWT_SECRET="your-very-long-random-secret-key-here"

# Groq API Key for LLM inference
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Production Frontend URL (deployed Vercel URL) — used for CORS
FRONTEND_URL="https://your-app-name.vercel.app"

# Server Port (Railway sets this automatically)
PORT=5000
